{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js tests/js tests/e2e",
        "format": "prettier --write resources/js tests/js tests/e2e",
        "format:check": "prettier --check resources/js tests/js tests/e2e",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:php": "php vendor/bin/pest",
        "check": "npm run typecheck && npm run lint && npm run test && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^9.0.1",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4"
    },
    "dependencies": {
        "@fontsource-variable/hanken-grotesk": "^5.3.0",
        "@fontsource/libre-caslon-display": "^5.3.0",
        "@fontsource/libre-caslon-text": "^5.3.0",
        "@inertiajs/react": "^3.9.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.55.0",
        "radix-ui": "^1.8.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0"
    }
}
