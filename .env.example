# ─────────────────────────────────────────────────────────────────────
# Aloe & Soul — environment configuration
# Copy to .env and fill in. Never commit .env. See docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────

APP_NAME="Aloe & Soul"
# local | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# MUST be false in production
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Timezone used for dashboard dates ("today") and order dates
APP_DISPLAY_TIMEZONE=Africa/Casablanca

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging: "daily" keeps 14 days of files in storage/logs
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# MySQL / MariaDB (Hostinger: hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aloeandsoul
DB_USERNAME=
DB_PASSWORD=

# Sessions, cache (incl. rate limits) and queue all use the database,
# which works on shared hosting without Redis or a long-running worker.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# MUST be true in production (HTTPS only cookies)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Optional: comma-separated proxy IPs whose X-Forwarded-* headers are trusted
# (e.g. a CDN in front of the site). Leave empty when visitors connect directly.
TRUSTED_PROXIES=

# Optional: separate secret for hashing IP addresses (defaults to APP_KEY)
IP_HASH_KEY=

# Mail — used for admin password reset links.
# Hostinger email: smtp.hostinger.com, port 465, scheme smtps
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional server-side rendering (needs a persistent Node.js process).
# Leave false on shared hosting; SEO tags are server-rendered by Blade anyway.
INERTIA_SSR_ENABLED=false
INERTIA_ENCRYPT_HISTORY=false

VITE_APP_NAME="${APP_NAME}"
